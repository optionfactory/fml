{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120,
        "attributePosition": "auto"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSpacing": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedFunctionParameters": "off",
                "noUnknownTypeSelector": "off"
            },
            "complexity": {
                "noStaticOnlyClass": "off",
                "noThisInStatic": "off"
            },
            "suspicious": {
                "noDoubleEquals": "off",
                "noExplicitAny": "off",
                "noAssignInExpressions": "off"
            },
            "a11y": {
                "useGenericFontNames": "off"
            },
            "style": {
                "noDescendingSpecificity": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["examples/**"],
            "linter": {
                "enabled": false
            }
        }
    ],
    "files": {
        "includes": ["**", "!dist", "!node_modules", "!coverage"]
    }
}
