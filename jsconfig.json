{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "noImplicitReturns": true,
        "checkJs": true,
        "allowJs": true
    },
    "include": ["src/**/*.mjs", "types/**/*.d.ts"]
}
